# Copy to .env on the VPS (prod) and adjust values.

# App security
JWT_SECRET_KEY=change-me-in-production
INVOICE_DOWNLOAD_SECRET=generate-a-distinct-random-secret-of-at-least-32-characters
GIFT_CARD_CODE_PEPPER=generate-a-distinct-random-secret-of-at-least-32-characters
TYPEFORM_WEBHOOK_SECRET=generate-a-random-secret-and-configure-it-on-every-typeform-webhook
BREVO_WEBHOOK_SECRET=generate-a-random-secret-and-configure-it-as-bearer-auth-on-brevo-webhooks
COOKIE_SECURE=true

# Email delivery
# LOG | SMTP | BREVO
EMAIL_PROVIDER=BREVO
EMAIL_FROM=no-reply@app.piano-academie.com
EMAIL_REPLY_TO=support@app.piano-academie.com
EMAIL_SUBJECT_PREFIX=[Piano Academie]

# Brevo SMTP relay
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Public frontend URL used in emails (login / payment links)
FRONTEND_BASE_URL=https://app.piano-academie.com

# Frontend -> backend request timeout (ms)
BACKEND_TIMEOUT_MS=30000

# Optional PSP fallback secrets (used if app_settings are empty)
PAYPLUG_TEST_SECRET_KEY=
PAYPLUG_LIVE_SECRET_KEY=
MOLLIE_TEST_API_KEY=
MOLLIE_LIVE_API_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Password reset link expiry
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Native mobile push notifications (disabled until Apple/Firebase keys exist)
PUSH_NOTIFICATIONS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_CLIENT_BUNDLE_ID=com.pianoacademie.client
APNS_USE_SANDBOX=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# One-way client/prospect contact synchronization to Zendesk
ZENDESK_SUBDOMAIN=piano-academie
ZENDESK_ADMIN_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SYNC_INTERVAL_MINUTES=15
